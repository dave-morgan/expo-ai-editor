{
  "name": "expo-ai-tools",
  "private": true,
  "version": "0.0.0",
  "description": "Select elements in a running Expo app, speak a change, and deliver it to an existing T3 Code thread.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --filter \"./packages/**\" run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bridge": "pnpm --filter @dave-morgan/expo-ai-bridge run start",
    "pack:all": "pnpm -r --filter \"./packages/**\" pack --pack-destination dist-packs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.0.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
