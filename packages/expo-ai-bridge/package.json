{
  "name": "@dave-morgan/expo-ai-bridge",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "expo-ai-bridge": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "!**/*.test.*",
    "!**/__tests__/**"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@dave-morgan/expo-ai-protocol": "workspace:*",
    "@dave-morgan/expo-ai-t3-adapter": "workspace:*",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dave-morgan/expo-ai-editor.git",
    "directory": "packages/expo-ai-bridge"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
